# Target del proxy /api para Vite en desarrollo (primario)
# Define una URL explicita en tu entorno local.
VITE_DEV_API_PROXY_TARGET=

# Fallback opcional para Vite dev proxy cuando VITE_DEV_API_PROXY_TARGET no exista
# Util para entornos docker/dev que ya exponen BACKEND_URL.
BACKEND_URL=

VITE_IMAGE_MAX_MB=25
